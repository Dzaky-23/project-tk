{
    "extends": "stylelint-config-standard",
    "rules": {
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "import",
                    "export",
                    "source",
                    "theme",
                    "apply",
                    "layer",
                    "custom-variant",
                    "config"
                ]
            }
        ]
    }
}